pipeline {
    agent any
    stages {
        stage('Test') {
            steps {
                bat 'docker run --rm node:20-alpine node --version'
            }
        }
        stage('Run in workspace') {
            steps {
                bat 'docker run --rm -v "%WORKSPACE%:/app" -w /app node:20-alpine ls -la'
            }
        }
    }
}
