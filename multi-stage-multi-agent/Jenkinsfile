pipeline {
    agent any

    stages {
        stage('Back-end') {
            steps {
                // Run Maven inside a Linux container, mounting the workspace
                bat 'docker run --rm -v "%WORKSPACE%:/app" -w /app maven:3.9-eclipse-temurin-17 mvn --version'
            }
        }
        stage('Front-end') {
            steps {
                // Run Node inside a Linux container, mounting the workspace
                bat 'docker run --rm -v "%WORKSPACE%:/app" -w /app node:20-alpine node --version'
            }
        }
    }
}
